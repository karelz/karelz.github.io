<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title and title != site.name %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="stylesheet" href="/assets/site.css">
  </head>
  <body class="{% if home %}home{% endif %}">
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">{{ site.name }}</a>
        <div class="header-links">
          <nav class="site-nav" aria-label="Main navigation">
            <a href="/" {% if section == "home" %}aria-current="page"{% endif %}>Home</a>
            <a href="/blog/" {% if section == "blog" %}aria-current="page"{% endif %}>Blog</a>
            <a href="/events/" {% if section == "events" %}aria-current="page"{% endif %}>Events</a>
          </nav>
          <nav class="social-nav" aria-label="Social links">
            <a href="{{ site.linkedin }}" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.04H3.54V8.98H7.1v11.47Z"/>
              </svg>
            </a>
            <a href="{{ site.github }}" aria-label="GitHub">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M7.999.431a7.76 7.76 0 0 0-2.453 15.124c.388.071.53-.168.53-.374l-.01-1.32c-2.159.469-2.614-1.04-2.614-1.04-.353-.896-.862-1.135-.862-1.135-.705-.481.053-.472.053-.472.779.055 1.189.8 1.189.8.692 1.186 1.816.843 2.258.645.071-.502.271-.843.493-1.037-1.723-.196-3.534-.861-3.534-3.835 0-.847.302-1.54.799-2.082-.08-.197-.347-.986.076-2.054 0 0 .652-.209 2.134.796A7.45 7.45 0 0 1 8 4.184a7.45 7.45 0 0 1 1.943.261c1.482-1.004 2.132-.796 2.132-.796.423 1.068.157 1.857.077 2.054.497.542.798 1.235.798 2.082 0 2.981-1.814 3.637-3.543 3.829.279.24.527.713.527 1.437l-.01 2.129c0 .208.14.449.534.373A7.762 7.762 0 0 0 7.999.431Z"/>
              </svg>
            </a>
          </nav>
        </div>
      </div>
    </header>

    <main id="content" class="shell">
      <article class="content">
        {{ content | safe }}
      </article>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>{{ site.name }}</span>
        <a href="https://github.com/karelz/karelz.github.io">View source on GitHub</a>
      </div>
    </footer>
  </body>
</html>
